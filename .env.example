# temp directory for processing
SEPA_TEMP_DIR="/tmp"

# RustFS S3 storage
RUSTFS_USER="your_rustfs_user"
RUSTFS_PASSWORD="your_rustfs_password"
RUSTFS_BUCKET="sepa-lakehouse"
RUSTFS_REGION="us-east-1"
RUSTFS_ENDPOINT="http://localhost:9000"
RUSTFS_ACCESS_KEY="your_rustfs_access_key"
RUSTFS_SECRET_KEY="your_rustfs_secret_key"
AWS_ACCESS_KEY_ID="your_rustfs_access_key"
AWS_SECRET_ACCESS_KEY="your_rustfs_secret_key"

# Apache Polaris REST catalog
POLARIS_URI="http://localhost:8181/api/catalog"
POLARIS_REALM="default"
POLARIS_CLIENT_ID="polaris"
POLARIS_CLIENT_SECRET="polaris"

# GCP (Optional)
GCP_PROJECT="your-gcp-project"
GCP_DATASET="silver"
GCP_DATASET_GOLD="gold"
GCP_BUCKET="your-gcp-bucket"
GCP_LOCATION="US"

# PyIceberg credentials
PYICEBERG_CATALOG__DEFAULT__S3__ACCESS_KEY_ID="your_rustfs_access_key"
PYICEBERG_CATALOG__DEFAULT__S3__SECRET_ACCESS_KEY="your_rustfs_secret_key"
